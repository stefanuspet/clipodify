# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Paths
OUTPUT_DIR=~/Downloads/clipodify
TMP_DIR=./tmp

# Whisper config
WHISPER_MODEL=large-v2
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Windowing
PAUSE_GAP_THRESHOLD=1.2
MAX_WINDOW_SECONDS=90
MIN_WINDOW_SECONDS=20

# Processing config
TOP_SEGMENTS=30
FINAL_CANDIDATES=15
CONTEXT_SECONDS=60

GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=32768

# Comment mining
MAX_COMMENTS=250
COMMENT_PAD_SECONDS=15
MIN_MENTIONS_FOR_SIGNAL=5

# Signal weights (harus total = 1.0)
WEIGHT_COMMENT=0.30
WEIGHT_AUDIO=0.25
WEIGHT_NARRATIVE=0.25
WEIGHT_TEXT=0.20

# Validasi pasca-Gemini
SNAP_TOLERANCE=30
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=90
DEDUPE_MIN_GAP=20
MAX_TYPE_RATIO=0.4
CLIP_TAIL_PAD_SECONDS=2.5
PAUSE_SILENCE_DB=-30
PAUSE_MIN_SECONDS=0.4
PAUSE_SNAP_TOLERANCE=1.0

CLIP_ATTRIBUTION=Potongan momen dari {source}.\n\nHak cipta sepenuhnya milik pemilik konten asli.\nHubungi via DM/Email untuk permintaan penghapusan konten.
CLIP_FIXED_HASHTAGS=

SOFTSELL_MAX_PITCH_RATIO=0.2
SOFTSELL_CLEAN_OPENING_SECONDS=3
CAMPAIGN_MIN_FIT=4.0

WHISPER_LANGUAGE=id
WHISPER_LANGUAGE_MIN_PROB=0.85

YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIE_FILE=
